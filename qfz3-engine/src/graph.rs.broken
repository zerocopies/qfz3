use crate::ggml_ffi::*;
const T_F32: i32 = 0;
const T_I32: i32 = 3;
use crate::ggml_ffi::*;
const T_F32: i32 = 0;
const T_I32: i32 = 3;
use crate::tokenizer::Tokenizer;
use std::ptr;

// Define constants if not in ffi
const T_F32: i32 = 0;
const T_I32: i32 = 3;

#[derive(Clone)]
pub struct KvSnapshot {
    pub rows: usize,
    pub data: Vec<f32>,
}

pub struct Session {
    pub turn_count: usize,
    pub context_len: usize,
    pub system_tokens: i32,
    pub history_tokens: i32,
    pub position: usize, // Fixed: Added missing field
}

pub struct Graph {
    pub ctx: *mut ggml_context,
    pub session: Session,
    pub d_token: *mut ggml_tensor,
    pub d_pos: *mut ggml_tensor,
    pub d_mask: *mut ggml_tensor,
    pub h_k: u32,
    pub h_d: u32,
    pub n_ctx: i32,
}

impl Graph {
    pub fn new(context_len: usize, _tokenizer: &Tokenizer, _arch: &str) -> Result<Self, String> {
        let ctx = unsafe { ggml_init(ggml_context_params {
            size: 1024 * 1024 * 10,
            no_alloc: false,
        }) };
        
        if ctx.is_null() {
            return Err("Failed to initialize ggml context".to_string());
        }

        let h_k = 32;
        let h_d = 32;
        let n_ctx = context_len as i32;

        // Fixed: Cast u32 to i64 for tensor dimensions
        let _kt = unsafe { ggml_new_tensor_2d(ctx, T_F32, (h_k * h_d) as i64, n_ctx as i64) };
        let _vt = unsafe { ggml_new_tensor_2d(ctx, T_F32, (h_k * h_d) as i64, n_ctx as i64) };

        Ok(Graph {
            ctx,
            session: Session {
                turn_count: 0,
                context_len,
                system_tokens: 0,
                history_tokens: 0,
                position: 0, // Initialized
            },
            d_token: ptr::null_mut(),
            d_pos: ptr::null_mut(),
            d_mask: ptr::null_mut(),
            h_k,
            h_d,
            n_ctx,
        })
    }

    pub fn build_forward(&mut self, n_tokens: u32) -> Result<(), String> {
        let ctx = self.ctx;
        let n_tokens_i64 = n_tokens as i64;

        // Fixed: Cast u32 to i64
        self.d_token = unsafe { ggml_new_tensor_1d(ctx, T_I32, n_tokens_i64) };
        self.d_pos = unsafe { ggml_new_tensor_1d(ctx, T_I32, n_tokens_i64) };
        self.d_mask = unsafe { ggml_new_tensor_2d(ctx, T_F32, self.n_ctx as i64, n_tokens_i64) };

        Ok(())
    }

    pub fn generate(&mut self, _tokens: &[u32], _max_tokens: i32) -> Result<String, String> {
        // Placeholder for generation loop
        Ok("Mock Output".to_string())
    }
}

impl Drop for Graph {
    fn drop(&mut self) {
        if !self.ctx.is_null() {
            unsafe { ggml_free(self.ctx) };
        }
    }
}
